# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chỉ dùng ở server (webhook SePay) - KHÔNG dùng tiền tố NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Cloudflare R2 (bucket để PRIVATE) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phongkham-images

# ---- SePay ----
# Tài khoản nhận tiền hiển thị trên QR (qr.sepay.vn)
NEXT_PUBLIC_SEPAY_ACCOUNT=0123456789
NEXT_PUBLIC_SEPAY_BANK=MBBank
# API Key đặt trong SePay > Tích hợp Webhooks (kiểu xác thực: API Key)
SEPAY_WEBHOOK_API_KEY=doi-thanh-chuoi-bi-mat
